{
  "name": "nbprint",
  "version": "0.12.3",
  "description": "A framework for customizing NBConvert templates and building reports",
  "repository": "git@github.com:nbprint/nbprint.git",
  "author": "Tim Paine <3105306+timkpaine@users.noreply.github.com>",
  "license": "Apache-2.0",
  "files": [
    "dist/**/*"
  ],
  "types": "index.d.ts",
  "scripts": {
    "build:debug": "node build.mjs --debug",
    "build:prod": "node build.mjs",
    "build": "node build.mjs",
    "clean": "rm -rf dist playwright-report ../nbprint/extension",
    "lint": "oxlint . && oxfmt --check \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "fix": "oxlint --fix . && oxfmt --write \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "preinstall": "npx only-allow pnpm",
    "prepack": "pnpm run build",
    "start:tests": "http-server -p 3000 ..",
    "start:examples": "http-server -p 3000 -o examples/",
    "test": "TZ=UTC playwright test",
    "test:structural": "TZ=UTC playwright test tests/structural.spec.js tests/typography.spec.js tests/page_regions.spec.js tests/page_box_fit.spec.js",
    "test:integration": "TZ=UTC playwright test --config integration.config.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "cpy": "^13.2.2",
    "esbuild": "^0.28.1",
    "lightningcss": "^1.33.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  }
}
